# Postgres (Neon — copy from neon.tech project page)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Postgres test branch (Neon — used by Vitest in Task 8)
TEST_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# NextAuth (generate AUTH_SECRET with: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Gemini — powers the AI agents. Free tier, no card needed:
# get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Secret for the Vercel Cron morning-briefing job (generate like AUTH_SECRET).
# Set it in Vercel env too — Vercel sends it as "Authorization: Bearer <value>"
# when invoking /api/cron/briefing on the vercel.json schedule.
CRON_SECRET=""
