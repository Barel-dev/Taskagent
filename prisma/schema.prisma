generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Which specialized agent produced a run. Only BREAKDOWN is wired up today;
// the rest are declared so the AgentRun log is forward-compatible.
enum AgentType {
  BREAKDOWN
  PRIORITIZER
  SCHEDULE
  EMAIL
  BRIEFING
}

enum AgentRunStatus {
  PENDING
  SUCCESS
  ERROR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  agentRuns     AgentRun[]
  createdAt     DateTime  @default(now())
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  // Self-relation: a task can be broken down into ordered subtasks.
  estimatedMinutes Int?
  parentId         String?
  parent           Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children         Task[]  @relation("Subtasks")

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([parentId])
}

// Audit log for every agent invocation — what went in, what came out,
// how many tokens it cost. Powers a future usage dashboard and makes the
// "shipped an AI agent" claim verifiable.
model AgentRun {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  agentType   AgentType
  status      AgentRunStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  tokensUsed  Int?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
}
