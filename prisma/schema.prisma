generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Which specialized agent produced a run. Only BREAKDOWN is wired up today;
// the rest are declared so the AgentRun log is forward-compatible.
enum AgentType {
  BREAKDOWN
  EXECUTE
  PRIORITIZER
  SCHEDULE
  EMAIL
  BRIEFING
}

enum AgentRunStatus {
  PENDING
  SUCCESS
  ERROR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]
  tags          Tag[]
  agentRuns     AgentRun[]
  createdAt     DateTime  @default(now())
}

// NextAuth required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  pinned      Boolean    @default(false)
  // NONE | DAILY | WEEKLY | MONTHLY — completing a recurring task spawns the next.
  recurrence  String     @default("NONE")
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  // Result of the Execute agent actually carrying out this task (e.g. a web
  // search report), kept so it persists across reloads.
  result    String?   @db.Text
  resultAt  DateTime?
  // Rich source cards (web previews with images) from the Execute agent.
  resultData Json?

  // A plan summary produced by the Summarize agent (rolls up subtasks + their
  // results), persisted for reloads.
  summary   String?   @db.Text
  summaryAt DateTime?

  // Shared context for the whole plan — the user's answers/preferences are
  // stored on the root task so every agent working on a subtask can read them
  // and stop asking the same questions.
  context String? @db.Text

  // Set by the Schedule agent when the user approves a proposed time slot: the
  // task gets a calendar block and we keep the Google event id so it can be
  // referenced later.
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  calendarEventId String?

  // Self-relation: a task can be broken down into ordered subtasks.
  estimatedMinutes Int?
  parentId         String?
  parent           Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children         Task[]  @relation("Subtasks")

  tags TaskTag[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([parentId])
}

// User-defined label that can be attached to many tasks.
model Tag {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String    @default("violet")
  createdAt DateTime  @default(now())
  tasks     TaskTag[]

  @@unique([userId, name])
  @@index([userId])
}

// Explicit join table between Task and Tag (explicit so the migration is
// straightforward to hand-write).
model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

// Audit log for every agent invocation — what went in, what came out,
// how many tokens it cost. Powers a future usage dashboard and makes the
// "shipped an AI agent" claim verifiable.
model AgentRun {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  agentType   AgentType
  status      AgentRunStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?
  tokensUsed  Int?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
}
